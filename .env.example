# Copy this to .env for local development.
# On the VM, Ansible generates .env automatically from GitHub Secrets.

GEMINI_API_KEY=your-gemini-api-key-here
GCP_PROJECT_ID=your-gcp-project-id
JWT_SECRET_KEY=generate-a-strong-random-secret-here
GRAFANA_ADMIN_PASSWORD=choose-a-strong-password
MONITORING_MOUNT=/mnt/monitoring   # local dev: create this dir and set to a local path
