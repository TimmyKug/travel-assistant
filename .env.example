# Copy this to .env for local development.
# On the VM, Ansible generates .env automatically from GitHub Secrets.

GEMINI_API_KEY=your-gemini-api-key-here
GCP_PROJECT_ID=your-gcp-project-id
FIREBASE_APP_ID=1:123456789:web:abcdef123456
GRAFANA_ADMIN_PASSWORD=choose-a-strong-password
MONITORING_MOUNT=/mnt/monitoring   # local dev: create this dir and set to a local path

# Firebase frontend config (baked into Vite bundle at docker build time)
# Get these from Firebase Console > Project Settings > Your apps > Web app
VITE_FIREBASE_API_KEY=your-firebase-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789
VITE_FIREBASE_APP_ID=1:123456789:web:abcdef123456
