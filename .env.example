# Copy this to .env for local development.
# On the VM, Ansible generates .env automatically from GitHub Secrets/Variables.
#
# GitHub Secrets (secrets.*) — sensitive, never logged:
#   GCP_SA_KEY, JWT_SECRET_KEY, GEMINI_API_KEY, GRAFANA_ADMIN_PASSWORD,
#   PROMETHEUS_HTPASSWD, FIREBASE_API_KEY, SSH_PRIVATE_KEY
#
# GitHub Variables (vars.*) — non-sensitive config:
#   GCP_PROJECT_ID, GCP_REGION, SSH_PUBLIC_KEY, TF_STATE_BUCKET,
#   FIREBASE_APP_ID, FIREBASE_STORAGE_BUCKET, FIREBASE_MESSAGING_SENDER_ID,
#   DOMAIN_NAME, CERTBOT_EMAIL

# ── GCP credentials (local only — CI uses GCP_SA_KEY GitHub Secret) ──────────
# Option 1 (simplest): gcloud auth application-default login
# Option 2 (service account): download a key and point GOOGLE_APPLICATION_CREDENTIALS at it
#   gcloud iam service-accounts keys create ~/ta-sa.json \
#     --iam-account=travel-assistant-vm@timmys-travel-assistant.iam.gserviceaccount.com
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/ta-sa.json

# ── App secrets ─────────────────────────────────────────────────────────────

# Google AI Studio → API keys tab
# https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# GCP Console → project selector (top bar) or Dashboard → Project info card
# https://console.cloud.google.com/
GCP_PROJECT_ID=your-gcp-project-id

# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=generate-a-strong-random-secret-here

# ── Monitoring secrets ───────────────────────────────────────────────────────

# Choose any strong password — used to log in to Grafana at /grafana
GRAFANA_ADMIN_PASSWORD=choose-a-strong-password

# Generate with: htpasswd -nb <user> <password>
# If htpasswd is not installed: brew install httpd  |  apt install apache2-utils
# https://httpd.apache.org/docs/current/programs/htpasswd.html
PROMETHEUS_HTPASSWD=prometheus:$apr1$...

# ── Firebase (baked into the frontend image at build time) ──────────────────
# All values are in Firebase Console → Project Settings → General → Your apps
# https://console.firebase.google.com/ → (select project) → ⚙ Settings
FIREBASE_API_KEY=your-firebase-api-key
FIREBASE_APP_ID=your-firebase-app-id
FIREBASE_STORAGE_BUCKET=your-project.appspot.com
FIREBASE_MESSAGING_SENDER_ID=your-sender-id

# ── Terraform (only needed for local `terraform` runs) ───────────────────────

# Same as GCP_PROJECT_ID above
TF_VAR_project_id=your-gcp-project-id

# Generate a key pair if you don't have one:
#   ssh-keygen -t ed25519 -C "deploy@travel-assistant"
# Then paste the contents of the .pub file here (single line, no quotes)
# Also add GCP_SA_KEY (service account JSON) as a GitHub Secret for CI:
#   GCP Console → IAM → Service Accounts → create key → JSON
#   https://console.cloud.google.com/iam-admin/serviceaccounts
TF_VAR_ssh_public_key="ssh-ed25519 AAAA..."

# Same as FIREBASE_APP_ID above
TF_VAR_firebase_app_id=your-firebase-app-id

# GCS bucket name used for Terraform remote state
# Create once with: gsutil mb -l europe-west3 gs://<bucket-name>
# https://developer.hashicorp.com/terraform/language/backend/gcs
TF_STATE_BUCKET=your-project-tf-state

# Optional — defaults defined in variables.tf (override here if needed):
# TF_VAR_region=europe-west3
# TF_VAR_zone=europe-west3-a
# TF_VAR_machine_type=e2-small
# TF_VAR_monitoring_machine_type=e2-small
# TF_VAR_monitoring_disk_size_gb=10
# TF_VAR_firestore_location=eur3

# ── Local dev overrides ──────────────────────────────────────────────────────
# MONITORING_MOUNT: on VM this is /mnt/monitoring; locally point to any writable dir
MONITORING_MOUNT=/tmp/monitoring
# LOKI_URL and IMAGE_TAG are derived from infra outputs in CI — set manually if needed locally
# LOKI_URL=http://localhost:3100/loki/api/v1/push
# IMAGE_TAG=latest
