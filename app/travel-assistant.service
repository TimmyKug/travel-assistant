[Unit]
Description=Travel Assistant Flask App (Gunicorn)
After=network.target

[Service]
Type=exec
User=ubuntu
Group=ubuntu
WorkingDirectory=/opt/travel-assistant
EnvironmentFile=/opt/travel-assistant/.env
ExecStop=/bin/kill -s TERM $MAINPID
ExecStopPost=/usr/bin/pkill -f gunicorn || true
ExecStart=/opt/travel-assistant/venv/bin/gunicorn \
    --workers 2 \
    --bind 0.0.0.0:5000 \
    --timeout 120 \
    --access-logfile /var/log/travel-assistant/access.log \
    --error-logfile /var/log/travel-assistant/error.log \
    --log-level info \
    app:app
ExecReload=/bin/kill -s HUP $MAINPID
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
