# Copy this to terraform.tfvars for local development
# DO NOT commit terraform.tfvars — it's in .gitignore

project_id             = "your-gcp-project-id"
region                 = "europe-west3"
zone                   = "europe-west3-a"
machine_type           = "e2-small"
monitoring_disk_size_gb = 10
ssh_public_key         = "ssh-ed25519 AAAA... your-key-comment"
