global:
  scrape_interval: 15s
  evaluation_interval: 15s
  external_labels:
    monitor: travel-assistant

scrape_configs:
  - job_name: prometheus
    static_configs:
      - targets: ['localhost:9090']

  - job_name: node_exporter
    static_configs:
      - targets: ['{{ app_internal_ip }}:9100']
    relabel_configs:
      - source_labels: [__address__]
        target_label: instance
        replacement: travel-app-vm

  - job_name: travel_assistant_backend
    metrics_path: /metrics
    static_configs:
      - targets: ['{{ app_internal_ip }}:80']
    relabel_configs:
      - source_labels: [__address__]
        target_label: instance
        replacement: travel-assistant-backend

  - job_name: grafana
    static_configs:
      - targets: ['grafana:3000']
