global:
  scrape_interval:     15s
  evaluation_interval: 15s
  external_labels:
    monitor: travel-assistant

# Load alert rules
rule_files:
  - /etc/prometheus/alerts.yml

# Send alerts to Alertmanager
alerting:
  alertmanagers:
    - static_configs:
        - targets: ['alertmanager:9093']

scrape_configs:

  # ── App VM — application metrics ───────────────────────────────────────────
  # Uses GCE service discovery so Prometheus automatically finds the correct
  # VM after the MIG autohealer replaces an unhealthy instance.
  # The monitoring VM's service account has roles/compute.viewer for this.
  - job_name: travel-assistant-api
    gce_sd_configs:
      - project: {{ gcp_project_id }}
        zone:    {{ zone }}
        filter:  'tags.items:travel-assistant'
        refresh_interval: 30s
    relabel_configs:
      # Scrape the app VM's /metrics via nginx on port 80 (avoids opening a
      # dedicated backend port to the monitoring VM).
      - source_labels: [__meta_gce_private_ip]
        target_label:  __address__
        replacement:   '$1:80'
      - source_labels: [__meta_gce_instance_name]
        target_label:  instance
    metrics_path: /metrics

  # ── App VM — Firestore integrity probe via Blackbox Exporter ───────────────
  - job_name: db-health
    metrics_path: /probe
    params:
      module: [http_2xx]
    gce_sd_configs:
      - project: {{ gcp_project_id }}
        zone:    {{ zone }}
        filter:  'tags.items:travel-assistant'
        refresh_interval: 30s
    relabel_configs:
      - source_labels: [__meta_gce_private_ip]
        target_label: __param_target
        replacement: http://$1/api/health/db
      - target_label: __address__
        replacement: blackbox-exporter:9115
      - source_labels: [__meta_gce_instance_name]
        target_label: instance

  # ── App VM — host metrics (node-exporter) ──────────────────────────────────
  - job_name: node-exporter-app
    gce_sd_configs:
      - project: {{ gcp_project_id }}
        zone:    {{ zone }}
        filter:  'tags.items:travel-assistant'
        refresh_interval: 30s
    relabel_configs:
      - source_labels: [__meta_gce_private_ip]
        target_label:  __address__
        replacement:   '$1:9100'
      - source_labels: [__meta_gce_instance_name]
        target_label:  instance

  # ── Monitoring VM — host metrics ───────────────────────────────────────────
  - job_name: node-exporter-monitoring
    static_configs:
      - targets: ['node-exporter:9100']

  # ── Prometheus self-monitoring ─────────────────────────────────────────────
  - job_name: prometheus
    static_configs:
      - targets: ['localhost:9090']

  # ── Alertmanager self-monitoring ───────────────────────────────────────────
  - job_name: alertmanager
    static_configs:
      - targets: ['alertmanager:9093']
