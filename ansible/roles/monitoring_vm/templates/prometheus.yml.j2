global:
  scrape_interval:     15s
  evaluation_interval: 15s

scrape_configs:

  # FastAPI application metrics (scraped via app VM nginx on port 80)
  - job_name: travel-assistant-api
    static_configs:
      - targets: ['{{ app_vm_internal_ip }}:80']
    metrics_path: /metrics

  # Node Exporter on the app VM for host-level metrics (CPU, memory, disk)
  - job_name: node-exporter-app
    static_configs:
      - targets: ['{{ app_vm_internal_ip }}:9100']

  # Node Exporter on the monitoring VM itself
  - job_name: node-exporter-monitoring
    static_configs:
      - targets: ['node-exporter:9100']

  # Prometheus self-monitoring
  - job_name: prometheus
    static_configs:
      - targets: ['localhost:9090']
