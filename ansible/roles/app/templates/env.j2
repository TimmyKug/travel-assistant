# Application secrets — written by Ansible, never committed
GEMINI_API_KEY={{ gemini_api_key }}
GCP_PROJECT_ID={{ gcp_project_id }}
JWT_SECRET_KEY={{ jwt_secret_key }}

# Grafana (used for docker-compose variable substitution)
GRAFANA_ADMIN_PASSWORD={{ grafana_admin_password }}

# Image tag for docker-compose
IMAGE_TAG={{ image_tag }}

# Prometheus (internal only)
MONITORING_MOUNT={{ monitoring_mount }}
