# Application secrets — written by Ansible, never committed
GEMINI_API_KEY={{ gemini_api_key }}
GCP_PROJECT_ID={{ gcp_project_id }}
FIREBASE_APP_ID={{ firebase_app_id }}
GOOGLE_APPLICATION_CREDENTIALS=/app/gcp-sa-key.json

# Firebase frontend config (baked into Vite bundle at docker build time)
VITE_FIREBASE_API_KEY={{ vite_firebase_api_key }}
VITE_FIREBASE_AUTH_DOMAIN={{ gcp_project_id }}.firebaseapp.com
VITE_FIREBASE_PROJECT_ID={{ gcp_project_id }}
VITE_FIREBASE_STORAGE_BUCKET={{ vite_firebase_storage_bucket }}
VITE_FIREBASE_MESSAGING_SENDER_ID={{ vite_firebase_messaging_sender_id }}
VITE_FIREBASE_APP_ID={{ firebase_app_id }}

# Grafana
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD={{ grafana_admin_password }}
GF_SERVER_ROOT_URL=%(protocol)s://%(domain)s/grafana/
GF_SERVER_SERVE_FROM_SUB_PATH=true
GF_AUTH_ANONYMOUS_ENABLED=false

# Prometheus (internal only)
MONITORING_MOUNT={{ monitoring_mount }}
